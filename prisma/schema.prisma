generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["koi_free_style", "public"]
}

// --- Public Schema (Koi Wordpress Data) ---
model categories {
  id                 BigInt               @id
  name               String
  slug               String               @unique
  description        String?
  parent_id          BigInt?
  image_url          String?
  product_count      Int                  @default(0)
  sort_order         Int                  @default(0)
  is_hidden          Boolean              @default(false)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  categories         categories?          @relation("categoriesTocategories", fields: [parent_id], references: [id], onUpdate: NoAction)
  other_categories   categories[]         @relation("categoriesTocategories")
  product_categories product_categories[]

  @@index([parent_id])
  @@index([slug])
  @@schema("public")
}

model leads {
  id         BigInt    @id @default(autoincrement())
  name       String
  phone      String
  email      String?
  message    String?
  product_id BigInt?
  source     String?
  status     String    @default("new")
  note       String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  products   products? @relation(fields: [product_id], references: [id], onUpdate: NoAction)

  @@index([status, created_at(sort: Desc)])
  @@schema("public")
}

model pages {
  id               BigInt  @id
  title            String
  slug             String  @unique
  content          String?
  meta_title       String?
  meta_description String?
  is_published     Boolean @default(true)

  @@schema("public")
}

model post_term_links {
  post_id    BigInt
  term_id    BigInt
  posts      posts      @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  post_terms post_terms @relation(fields: [term_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([post_id, term_id])
  @@index([term_id])
  @@schema("public")
}

model post_terms {
  id              BigInt            @id
  name            String
  slug            String
  description     String?
  taxonomy        String
  post_count      Int               @default(0)
  post_term_links post_term_links[]

  @@unique([taxonomy, slug])
  @@index([taxonomy, post_count(sort: Desc)])
  @@index([taxonomy, slug])
  @@schema("public")
}

model posts {
  id               BigInt            @id
  title            String
  slug             String            @unique
  excerpt          String?
  content          String?
  cover_image      String?
  meta_title       String?
  meta_description String?
  is_published     Boolean           @default(true)
  published_at     DateTime?         @db.Timestamptz(6)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  post_term_links  post_term_links[]

  @@index([is_published, published_at(sort: Desc)])
  @@schema("public")
}

model product_categories {
  product_id  BigInt
  category_id BigInt
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products    products   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([product_id, category_id])
  @@index([category_id])
  @@schema("public")
}

model product_images {
  id           BigInt   @id @default(autoincrement())
  product_id   BigInt
  storage_path String
  alt          String?
  is_primary   Boolean  @default(false)
  sort_order   Int      @default(0)
  /// Kích thước ảnh gốc, tính bằng pixel. Có thật trong DB và đã điền đủ cho
  /// cả 2178 dòng, nhưng trước đây thiếu khai báo ở đây — chạy `prisma db push`
  /// là Prisma coi như thừa và XOÁ mất hai cột này cùng toàn bộ số liệu.
  width        Int?
  height       Int?
  products     products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id, sort_order])
  @@schema("public")
}

model product_tags {
  product_id BigInt
  tag_id     BigInt
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tags       tags     @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([product_id, tag_id])
  @@index([tag_id])
  @@schema("public")
}

model product_variants {
  id           BigInt   @id
  product_id   BigInt
  name         String?
  sku          String?
  price        BigInt?
  attributes   Json     @default("{}")
  image_url    String?
  is_available Boolean  @default(true)
  sort_order   Int      @default(0)
  products     products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id])
  @@schema("public")
}

model products {
  id                 BigInt               @id
  name               String
  slug               String               @unique
  sku                String?
  short_description  String?
  description        String?
  price              BigInt?
  regular_price      BigInt?
  sale_price         BigInt?
  price_min          BigInt?
  price_max          BigInt?
  on_sale            Boolean              @default(false)
  has_variants       Boolean              @default(false)
  is_available       Boolean              @default(true)
  is_published       Boolean              @default(true)
  is_featured        Boolean              @default(false)
  meta_title         String?
  meta_description   String?
  search_text        String?
  sort_order         Int                  @default(0)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  leads              leads[]
  product_categories product_categories[]
  product_images     product_images[]
  product_tags       product_tags[]
  product_variants   product_variants[]

  @@index([is_published, sort_order])
  @@index([slug])
  @@schema("public")
}

model redirects {
  id          BigInt @id @default(autoincrement())
  from_path   String @unique
  to_path     String
  status_code Int    @default(301)

  @@schema("public")
}

model tags {
  id            BigInt         @id
  name          String
  slug          String         @unique
  description   String?
  product_count Int            @default(0)
  product_tags  product_tags[]

  @@index([product_count(sort: Desc)])
  @@index([slug])
  @@schema("public")
}

// --- Koi Free Style Models (Koi Leather App) ---
model KoiCategory {
  id              String               @id @default(uuid())
  code            String               @unique
  name            String
  slug            String               @unique
  description     String?
  specsSchema     String               @default("{}")
  metaTitle       String?
  metaDescription String?
  displayOrder    Int                  @default(0)
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  products        KoiProduct[]
  categoryLinks   KoiProductCategory[]

  @@index([isActive])
  @@index([displayOrder])
  @@map("koi_categories")
  @@schema("koi_free_style")
}

// Bảng nối nhiều–nhiều: 1 sản phẩm thuộc nhiều danh mục và ngược lại.
// categoryId cũ trên KoiProduct vẫn giữ làm "danh mục chính" (tương thích ngược).
model KoiProductCategory {
  productId  String
  categoryId String
  product    KoiProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   KoiCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("koi_product_categories")
  @@schema("koi_free_style")
}

// Bảng nối: 1 sản phẩm có thể mang nhiều màu (vd ví phối đen + vàng bò).
// colorFamily/colorHex cũ trên KoiProduct vẫn giữ làm "màu chính" (chấm đầu
// tiên, tương thích ngược cho chỗ nào chưa đọc bảng nối).
model KoiProductColor {
  productId   String
  colorFamily String
  colorHex    String?
  sortOrder   Int        @default(0)
  product     KoiProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@id([productId, colorFamily])
  @@index([colorFamily])
  @@map("koi_product_colors")
  @@schema("koi_free_style")
}

// Bảng nối: 1 sản phẩm có thể dùng nhiều loại da (vd thân Epsom, lót Swift).
// materialCategoryId cũ trên KoiProduct giữ làm "loại da chính".
model KoiProductMaterialCategory {
  productId          String
  materialCategoryId String
  sortOrder          Int                 @default(0)
  product            KoiProduct          @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialCategory   KoiMaterialCategory @relation(fields: [materialCategoryId], references: [id], onDelete: Cascade)
  createdAt          DateTime            @default(now())

  @@id([productId, materialCategoryId])
  @@index([materialCategoryId])
  @@map("koi_product_material_categories")
  @@schema("koi_free_style")
}

model KoiProduct {
  id                    String                       @id @default(uuid())
  name                  String
  slug                  String                       @unique
  productType           String
  categoryId            String?
  description           String?
  // Mô tả dạng khối (JSON: {"blocks":[…]}) do trình dựng khối trong admin lưu.
  // `description` vẫn là HTML — koi-storefront render trực tiếp bằng
  // dangerouslySetInnerHTML nên không được đổi định dạng cột đó. Cột này chỉ để
  // mở lại đúng cấu trúc người bán đã soạn; HTML luôn được in lại từ nó bằng
  // blocksToHtml() trong src/product/description-blocks.ts.
  // Null = mô tả cũ từ WordPress chưa qua trình dựng khối.
  descriptionBlocks     String?
  basePrice             Float?
  priceMin              Float?
  priceMax              Float?
  hasVariants           Boolean                      @default(false)
  status                String                       @default("DRAFT")
  sku                   String?                      @unique
  externalId            String?
  technicalSpecs        String                       @default("{}")
  metaTitle             String?
  metaDescription       String?
  canonicalUrl          String?
  isDeleted             Boolean                      @default(false)
  deletedAt             DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  materialCategoryId    String?
  // Màu sắc: colorFamily (mã nhóm màu chuẩn, dùng để LỌC) + colorHex (mã màu
  // thật, chỉ để hiện chấm màu trên thẻ). Xem KoiColorFamily trong common/enums.
  colorFamily           String?
  colorHex              String?
  // Thứ tự hiện ở cửa hàng. Trước đây danh sách xếp theo basePrice desc nên
  // trang 1 toàn hàng 19–79tr (trung bình 30,7tr) trong khi trung vị cả shop
  // chỉ 4tr — khách tưởng shop chỉ bán đồ đắt.
  //   isFeatured : hàng "đinh" do người bán tự tick, luôn nằm đầu.
  //   displayRank: điểm xếp sẵn cho phần còn lại, tính bằng
  //                scripts/compute-display-rank.js. Tính sẵn thành số nguyên
  //                vì công thức có bước cài răng lược dải giá — không diễn đạt
  //                được bằng ORDER BY, mà xếp trong RAM thì phân trang sẽ nhảy.
  //                Sau này khi koi_page_views đủ dày thì chỉ cần chạy lại
  //                script từ lượt xem thật, không phải sửa truy vấn.
  isFeatured            Boolean                      @default(false)
  displayRank           Int                          @default(999999)
  // Bản KHÔNG DẤU của `name`, do POSTGRES TỰ TÍNH (GENERATED ALWAYS AS … STORED)
  // — xem prisma/migrations/20260803150000_add_product_search_text.
  //
  // Cần vì bộ sinh slug cũ làm rụng chữ hoa có dấu, nên 120/324 slug đang có bị
  // sai và 51 sản phẩm gõ đủ tên không dấu vẫn không ra ("Ốp Lưng…" → slug
  // "p-lung-…"). Không viết lại slug vì đó là URL Google đã đánh chỉ mục.
  //
  // KHÔNG BAO GIỜ ghi vào cột này: Postgres từ chối ("can only be updated to
  // DEFAULT") và Prisma cũng không sinh nó vào input type. Muốn đổi thì sửa
  // `name`, cột này tự theo. Đó là lý do chọn cột sinh: product.service.ts có
  // 8+ chỗ ghi sản phẩm, cột thường thì quên một chỗ là dữ liệu tìm kiếm lệch
  // âm thầm.
  searchText            String?
  category              KoiCategory?                 @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  materialCategory      KoiMaterialCategory?         @relation(fields: [materialCategoryId], references: [id], onDelete: SetNull)
  categoryLinks         KoiProductCategory[]
  colorLinks            KoiProductColor[]
  materialCategoryLinks KoiProductMaterialCategory[]
  images                KoiProductImage[]
  variants              KoiProductVariant[]
  craftSpecs            KoiCraftingSpec[]
  seoRecords            KoiSEORecord[]

  @@index([productType])
  @@index([status])
  @@index([slug])
  @@index([categoryId])
  @@index([createdAt])
  @@index([categoryId, status])
  @@index([materialCategoryId])
  @@index([colorFamily])
  // Chỉ mục phủ đúng thứ tự ORDER BY của danh sách cửa hàng.
  @@index([isFeatured, displayRank])
  @@map("koi_products")
  @@schema("koi_free_style")
}

model KoiProductImage {
  id           String             @id @default(uuid())
  productId    String
  variantId    String?
  url          String
  thumbnailUrl String
  mediumUrl    String?
  altText      String?
  imageType    String             @default("STUDIO")
  isPrimary    Boolean            @default(false)
  displayOrder Int                @default(0)
  mimeType     String?
  fileSize     Int?
  width        Int?
  height       Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  product      KoiProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      KoiProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@index([isPrimary])
  @@map("koi_product_images")
  @@schema("koi_free_style")
}

model KoiProductVariant {
  id             String               @id @default(uuid())
  productId      String
  sku            String               @unique
  title          String?
  price          Float?
  hardwareOption String               @default("none")
  stockStatus    String               @default("IN_STOCK")
  isDefault      Boolean              @default(false)
  options        String               @default("{}")
  images         String?
  craftingSpecId String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  product        KoiProduct           @relation(fields: [productId], references: [id], onDelete: Cascade)
  craftingSpec   KoiCraftingSpec?     @relation(fields: [craftingSpecId], references: [id], onDelete: SetNull)
  images_rel     KoiProductImage[]
  orders         KoiProductionOrder[]

  @@index([productId])
  @@index([sku])
  @@index([stockStatus])
  @@map("koi_product_variants")
  @@schema("koi_free_style")
}

model KoiCraftingSpec {
  id              String              @id @default(uuid())
  productId       String
  patternFiles    String              @default("[]")
  outerLeather    String              @default("{}")
  liningLeather   String              @default("{}")
  interlining     String              @default("{}")
  dimensions      String              @default("{}")
  craftingDetails String              @default("{}")
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  product         KoiProduct          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants        KoiProductVariant[]

  @@index([productId])
  @@map("koi_crafting_specs")
  @@schema("koi_free_style")
}

model KoiRawMaterial {
  id                 String                    @id @default(uuid())
  name               String
  materialType       String
  supplier           String?
  unit               String
  color              String?
  thicknessMm        Float?
  totalQuantity      Float                     @default(0)
  reservedQuantity   Float                     @default(0)
  availableQuantity  Float                     @default(0)
  unitCost           Float
  currency           String                    @default("VND")
  externalId         String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  materialCategoryId String?
  materialCategory   KoiMaterialCategory?      @relation(fields: [materialCategoryId], references: [id], onDelete: SetNull)
  transactions       KoiInventoryTransaction[]

  @@index([materialType])
  @@index([externalId])
  @@index([supplier])
  @@index([materialCategoryId])
  @@map("koi_raw_materials")
  @@schema("koi_free_style")
}

model KoiInventoryTransaction {
  id                String         @id @default(uuid())
  materialId        String
  orderId           String?
  transactionType   String
  quantity          Float
  batchRef          String?
  costAtTransaction Float?
  notes             String?
  createdAt         DateTime       @default(now())
  material          KoiRawMaterial @relation(fields: [materialId], references: [id])

  @@index([materialId])
  @@index([orderId])
  @@index([transactionType])
  @@index([createdAt])
  @@map("koi_inventory_transactions")
  @@schema("koi_free_style")
}

model KoiProductionOrder {
  id                 String            @id @default(uuid())
  variantId          String
  quantity           Int
  status             String            @default("PENDING")
  craftsman          String?
  dueDate            DateTime?
  materialsAllocated String            @default("[]")
  totalCostSnapshot  Float?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  variant            KoiProductVariant @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@index([status])
  @@index([createdAt])
  @@map("koi_production_orders")
  @@schema("koi_free_style")
}

model KoiSEORecord {
  id                String      @id @default(uuid())
  entityType        String
  entityId          String
  slug              String      @unique
  slugHistory       String      @default("[]")
  jsonLd            String      @default("{}")
  ogTitle           String?
  ogDescription     String?
  ogImage           String?
  metaTitle         String?
  metaDescription   String?
  noIndex           Boolean     @default(false)
  sitemapPriority   Float?
  sitemapChangeFreq String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  product           KoiProduct? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([slug])
  @@map("koi_seo_records")
  @@schema("koi_free_style")
}

model KoiImageCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@map("koi_image_categories")
  @@schema("koi_free_style")
}

model KoiMaterialCategory {
  id           String                       @id @default(uuid())
  code         String                       @unique
  name         String
  description  String?
  sortOrder    Int                          @default(0)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  materials    KoiRawMaterial[]
  products     KoiProduct[]
  productLinks KoiProductMaterialCategory[]

  @@index([code])
  @@map("koi_material_categories")
  @@schema("koi_free_style")
}

/// Một lượt xem trang trên storefront koileather.com.
///
/// KHÔNG lưu IP thô. visitorHash = băm(IP + trình duyệt + muối + ngày), nên:
///   - đếm được khách riêng biệt TRONG NGÀY
///   - sang ngày mới thì cùng một người ra hash khác => không lần được hành vi
///     dài ngày, không truy ngược ra danh tính
model KoiPageView {
  id          String   @id @default(uuid())
  /// Đường dẫn đã chuẩn hoá, bỏ query để /cua-hang/?page=2 không tách dòng riêng
  path        String
  /// Tên miền nơi khách bấm sang (google, facebook…). null = gõ thẳng địa chỉ
  referrer    String?
  /// Gom referrer về nhóm để đếm: direct | google | facebook | zalo | other
  source      String
  /// mobile | tablet | desktop — đoán từ User-Agent
  device      String
  /// Băm ẩn danh, đổi mỗi ngày. Xem ghi chú ở trên.
  visitorHash String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([source])
  @@index([visitorHash])
  @@map("koi_page_views")
  @@schema("koi_free_style")
}

/// Ai đang ở trên web NGAY LÚC NÀY, và đang đứng ở trang nào.
///
/// Vì sao phải có bảng riêng, không suy ra từ koi_page_views:
///
///  1. Muốn biết khách CÒN đang xem hay đã đóng tab thì phải có nhịp tim
///     (heartbeat) gửi đều đặn. Nếu nhồi nhịp tim vào koi_page_views thì một
///     khách ngồi đọc 10 phút hoá thành 10 "lượt xem" — mọi con số cũ (lượt
///     xem, trang/khách, biểu đồ theo ngày) phồng lên và không còn tin được.
///     Tách bảng thì nhịp tim chỉ ghi đè MỘT dòng, bảng lượt xem sạch nguyên.
///
///  2. Một dòng cho mỗi khách, ghi đè liên tục => bảng luôn nhỏ (bằng số khách
///     trong ngày), truy vấn "đang online" chỉ quét vài chục dòng thay vì lọc
///     cả bảng lượt xem đang lớn dần theo thời gian.
///
/// visitorHash làm khoá chính: cùng một khách chỉ giữ đúng một dòng.
/// Hash đổi mỗi ngày (xem KoiPageView) nên dòng cũ thành rác — dọn theo
/// lastSeenAt trong realtime(), không phải theo ngày.
model KoiPresence {
  /// Băm ẩn danh, y hệt KoiPageView.visitorHash. Khoá chính để upsert.
  visitorHash String   @id
  /// Trang khách đang đứng ngay lúc này.
  path        String
  /// Nguồn dẫn khách vào site — giữ nguồn ĐẦU phiên, không đè bằng 'internal'.
  /// Xem ghi chú ở analytics.service.ts: đè thì sau một cú bấm ai cũng thành
  /// 'internal' và bảng nguồn realtime thành vô nghĩa.
  source      String
  device      String
  /// Lần đầu thấy trong phiên — để hiện "đã ở trên web 3 phút".
  firstSeenAt DateTime @default(now())
  /// Nhịp tim gần nhất. Quá ngưỡng thì coi như đã rời đi.
  lastSeenAt  DateTime @default(now())

  @@index([lastSeenAt])
  @@map("koi_presence")
  @@schema("koi_free_style")
}

/// Một cú bấm nút liên hệ — Zalo, Messenger, hay Gọi điện — của BẤT KỲ khách nào.
///
/// VÌ SAO CẦN BẢNG NÀY. Trước bảng này, cú bấm nút liên hệ chỉ được ghi ở
/// koi_ad_clicks.contactedAt, mà dòng đó chỉ tồn tại khi khách đến từ quảng cáo
/// Google (phải có gclid). Khách vào từ Google tự nhiên, từ Facebook, hay gõ
/// thẳng địa chỉ rồi bấm Zalo thì KHÔNG CÓ DÒNG NÀO Ở ĐÂU CẢ — mà đó là phần
/// đông khách. Chủ shop mở admin ra chỉ thấy phần khách quảng cáo và tưởng đó là
/// toàn bộ.
///
/// Bảng này ghi MỌI cú bấm, kèm NGUỒN dẫn khách vào. Đó là thứ trả lời được câu
/// "khách nhắn tin cho mình đến từ đâu" — koi_ad_clicks không lưu nguồn, vì với
/// nó mọi dòng đều đến từ quảng cáo.
///
/// VÌ SAO KHÔNG NHỒI CỜ VÀO koi_page_views. Cùng lý do koi_presence phải tách ra
/// (xem ghi chú ở model đó): nhồi một loại dòng khác vào bảng lượt xem là mọi
/// con số cũ — lượt xem, trang/khách, biểu đồ theo ngày — phồng lên và không
/// còn tin được. Bảng riêng thì bảng lượt xem sạch nguyên.
///
/// MỖI CÚ BẤM MỘT DÒNG, KHÔNG GỘP. Khách bấm Zalo ở đầu trang rồi cuộn xuống
/// bấm tiếp là hai dòng, vì cả hai đều là cú bấm thật. Nên số dòng là SỐ LẦN
/// liên hệ, không phải số người — muốn số người thì đếm visitorHash riêng biệt.
/// Đây là chỗ khác hẳn koi_ad_clicks: bên đó buộc phải chốt lần bấm ĐẦU để giữ
/// mốc giờ cho Google khử trùng lặp, còn bảng này không gửi đi đâu cả.
model KoiContactClick {
  id          String   @id @default(uuid())
  /// zalo | messenger | phone. Chỉ nhận đúng ba giá trị này — đường ghi là
  /// đường công khai nên phải lọc, không thì ai gửi gì vào cũng nằm trong bảng.
  channel     String
  /// Trang khách đang đứng lúc bấm. Đã bỏ query, y hệt KoiPageView.path.
  path        String
  /// Nguồn dẫn khách vào, gom nhóm bằng CHÍNH hàm nguon() của lượt xem:
  /// direct | google | facebook | zalo | instagram | tiktok | search_khac |
  /// internal | other. Dùng chung hàm là điều kiện bắt buộc — tự phân nhóm lại
  /// thì bảng nguồn của hai panel đếm theo hai định nghĩa khác nhau.
  source      String
  /// Referrer thô, giữ lại để còn truy được khi nhóm ở trên gom vào 'other'.
  referrer    String?
  /// mobile | tablet | desktop — đoán từ User-Agent.
  device      String
  /// Băm ẩn danh, y hệt KoiPageView.visitorHash: đổi mỗi ngày, không truy ngược
  /// ra danh tính. Đếm được "số người" trong ngày mà vẫn không lưu IP thô.
  visitorHash String
  /// Sản phẩm khách đang xem lúc bấm, nếu nút nằm ở trang sản phẩm.
  productName String?
  /// Mã quảng cáo nếu khách này đến từ quảng cáo. Sợi dây đối chiếu với
  /// koi_ad_clicks, KHÔNG phải khoá ngoại: donRac() bên ads xoá dòng chưa chốt
  /// sau 120 ngày, có khoá ngoại là nó chặn hoặc xoá lây sang bảng này.
  adToken     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([channel])
  @@index([source])
  @@map("koi_contact_clicks")
  @@schema("koi_free_style")
}

/// Một cú bấm quảng cáo Google, nối với cuộc trò chuyện Zalo mà nó đẻ ra.
///
/// VÌ SAO CẦN BẢNG NÀY. Google Ads chỉ học được cách tiêu tiền cho khôn nếu ta
/// nói lại cho nó biết cú bấm nào ra ĐƠN THẬT. Muốn nói lại thì phải giữ được
/// `gclid` — mã Google gắn vào URL lúc khách bấm quảng cáo. Site này không bán
/// online, mọi đơn chốt trong hộp thoại Zalo, nên không có trang "cảm ơn" nào
/// để tự nối. Bảng này là sợi dây nối thủ công đó.
///
/// CÁCH CHẠY: khách vào từ quảng cáo → lưu gclid, sinh một MÃ NGẮN → mã đó
/// được nhét vào tin nhắn Zalo soạn sẵn → chủ shop thấy mã trong hộp thoại →
/// chốt đơn thì vào admin gõ mã, điền số tiền → xuất CSV tải lên Google Ads.
///
/// HẠN 90 NGÀY: Google chỉ nhận doanh số trong vòng 90 ngày kể từ cú bấm. Quá
/// hạn thì dòng đó thành rác, xem cột `clickedAt`.
model KoiAdClick {
  /// Mã ngắn hiện trong tin nhắn Zalo (ví dụ "K7F2QM"). Chủ shop đọc bằng mắt
  /// rồi gõ tay vào admin nên phải NGẮN và không có ký tự dễ nhìn nhầm —
  /// xem BANG_CHU_CAI ở ads.service.ts. Khoá chính luôn: tra cứu toàn theo mã.
  token       String    @id
  /// Mã cú bấm của Google, lấy từ tham số ?gclid= trên URL khách vào.
  /// Đây là thứ DUY NHẤT Google nhận để nối ngược về quảng cáo.
  gclid       String?
  /// Bản iOS của gclid: gbraid (web→app) và wbraid (app→web). Hiếm với site
  /// này nhưng vẫn giữ — mất là mất hẳn, không lấy lại được.
  gbraid      String?
  wbraid      String?
  /// Trang khách đáp xuống. Để biết quảng cáo đang kéo người vào đâu.
  landingPath String?
  /// Sản phẩm khách đang xem lúc bấm nút liên hệ. Giúp chủ shop nhận ra cuộc
  /// trò chuyện nào ứng với mã nào khi hộp thoại Zalo có nhiều người cùng lúc.
  productName String?
  /// zalo | messenger | phone — kênh khách đã bấm.
  channel     String?
  /// Lúc khách bấm quảng cáo. MỐC TÍNH HẠN 90 NGÀY, không phải lúc chốt đơn.
  clickedAt   DateTime  @default(now())
  /// Lúc khách bấm nút Zalo/Messenger. null = mới vào xem rồi đi, chưa nhắn.
  contactedAt DateTime?
  /// Chủ shop đánh dấu đã chốt: thời điểm chốt. Đây là giờ gửi cho Google.
  convertedAt DateTime?
  /// Giá trị đơn, VND. Dùng BigInt cho khớp nếp giá của bảng products và vì
  /// tiền Việt số to — Int 32-bit chỉ tới ~2,1 tỉ, một đơn buôn là tràn.
  value       BigInt?
  /// Ghi chú tay của chủ shop (tên khách, mã đơn...).
  note        String?
  /// Đã xuất ra CSV tải lên Google chưa. Chặn tính hai lần khi xuất nhiều lần.
  exportedAt  DateTime?

  /// Bảng xếp theo thứ tự thời gian ở admin, và hàm dọn rác xoá theo cột này.
  @@index([clickedAt])
  /// Lọc nhanh "đã chốt nhưng chưa xuất" — truy vấn chính của nút xuất CSV.
  @@index([convertedAt])
  @@map("koi_ad_clicks")
  @@schema("koi_free_style")
}

/// Bản chữ GỐC của một trường, chụp lại NGAY TRƯỚC khi AI ghi đè lên.
///
/// VÌ SAO BẢNG NÀY LÀ BẮT BUỘC, KHÔNG PHẢI TÍNH NĂNG THÊM:
/// Công cụ sửa bằng AI ghi thẳng vào nội dung đang chạy trên site — bài viết có
/// organic traffic, mô tả sản phẩm khách đang đọc. Mô hình ngôn ngữ thì không
/// đảm bảo gì về đầu ra: nó có thể bỏ mất đoạn, đổi số đo, viết lại thành giọng
/// khác, hoặc cắt ngắn một bài 2000 chữ thành 300. Không có bảng này thì chữ gốc
/// mất VĨNH VIỄN ngay lần bấm đầu tiên — cột cũ đã bị UPDATE ghi đè, Postgres
/// không giữ bản trước, và site không có bản sao lưu theo từng bản ghi.
///
/// Mỗi dòng là MỘT TRƯỜNG của MỘT bản ghi. Sửa một bài đụng 3 trường thì sinh 3
/// dòng cùng `batch` — hoàn tác là trả lại cả nhóm, không lẻ từng trường.
model KoiContentRevision {
  id        String   @id @default(uuid())
  /// Nhóm các trường được sửa trong cùng một lần bấm Áp dụng. Hoàn tác đi theo
  /// nhóm: sửa tiêu đề + mô tả rồi chỉ trả lại một cái là ra bản ghi nửa vời.
  batch     String
  /// Loại nội dung: post | page | product | category | product_tag | blog_term.
  /// Quyết định bảng nào được ghi khi hoàn tác — xem BAN_DO_LOAI ở ai-edit.service.ts.
  kind      String
  /// Khoá chính của bản ghi, LUÔN là chuỗi. Bảng public dùng BigInt, bảng
  /// koi_free_style dùng UUID; nhét cả hai vào một cột thì chuỗi là kiểu duy
  /// nhất chứa được cả hai mà không mất mát.
  recordId  String
  /// Đường dẫn công khai lúc sửa. Chỉ để chủ shop nhận ra mình đã sửa trang nào
  /// khi xem lại danh sách — KHÔNG dùng để tra bản ghi lúc hoàn tác, vì slug có
  /// thể đã đổi từ lúc đó.
  path      String?
  /// Tên trường trong DB (title, content, meta_description, description...).
  field     String
  /// Chữ TRƯỚC khi sửa. null nghĩa là trường đó đang trống — phải phân biệt với
  /// chuỗi rỗng, vì hoàn tác cần trả lại đúng null chứ không phải "".
  before    String?
  /// Chữ SAU khi sửa. Giữ lại để đối chiếu: nếu trường hiện tại không còn khớp
  /// `after` thì đã có người sửa tay sau AI, và hoàn tác sẽ đè mất công đó —
  /// ai-edit.service.ts cảnh báo thay vì âm thầm ghi.
  after     String?
  /// Nguyên văn câu lệnh chủ shop đã viết. Để biết vì sao chữ ra như vậy, và để
  /// dùng lại câu lệnh đã cho kết quả tốt cho bài khác.
  prompt    String?
  /// Model đã dùng (ví dụ gpt-4.1-mini). Đổi model là đổi giọng văn — không ghi
  /// lại thì về sau không biết bài nào do model nào viết.
  model     String?
  /// Email admin đã bấm. Lấy từ JWT, không phải do phía trình duyệt khai.
  actor     String?
  /// Đã bấm hoàn tác chưa. Giữ dòng lại chứ không xoá: cần biết bản ghi này từng
  /// bị sửa rồi trả lại, nếu không thì lịch sử mất một mắt.
  revertedAt DateTime?
  createdAt DateTime @default(now())

  /// Danh sách "sửa gần đây" ở admin xếp theo cột này.
  @@index([createdAt])
  /// Tra nhanh mọi lần sửa của một bản ghi — dùng khi hiện cảnh báo "trang này
  /// đã bị AI sửa 3 lần trước đó".
  @@index([kind, recordId])
  /// Hoàn tác lấy trọn một nhóm.
  @@index([batch])
  @@map("koi_content_revisions")
  @@schema("koi_free_style")
}

/// Sổ tay từ khoá quảng cáo — lập kế hoạch nội bộ, không nối trực tiếp Google Ads API.
/// VÌ SAO BẢNG NÀY: Google Ads không cung cấp giao diện gọn để ghi chú chiến thuật
/// theo từng từ khoá. Bảng này là nơi chủ shop ghi lại từ khoá đang đặt giá, loại
/// khớp, chiến dịch, và quan sát tối ưu — đối chiếu với số liệu cú bấm trong bảng
/// koi_ad_clicks để biết từ khoá nào ra khách, từ khoá nào đốt tiền không hiệu quả.
/// Đây là sổ tay, không phải bản sao của tài khoản Google Ads.
model KoiAdKeyword {
  id        String   @id @default(uuid())

  /// Nội dung từ khoá, ví dụ "bóp da bò thật" hay "mua ví da koileather".
  tuKhoa    String

  /// Tên chiến dịch Google Ads. Để trống nếu chỉ có một chiến dịch.
  chienDich String?

  /// Loại khớp: broad | phrase | exact | negative. Null = chưa phân loại.
  loaiKhop  String?

  /// active = đang chạy, paused = tạm dừng.
  trangThai String   @default("active")

  /// Ghi chú tối ưu: CPC thực tế, tỷ lệ chuyển đổi, quan sát về lượt xem trang...
  ghiChu    String?

  taoLuc     DateTime @default(now())

  /// Lần cuối chỉnh sửa — theo dõi ai cập nhật gần nhất khi audit chiến dịch.
  capNhatLuc DateTime @updatedAt

  /// Lọc nhanh theo trạng thái — hiện active trước, paused sau.
  @@index([trangThai])
  @@map("koi_ad_keywords")
  @@schema("koi_free_style")
}
