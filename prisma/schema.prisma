generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["koi_free_style", "public"]
}

// --- Public Schema (Koi Wordpress Data) ---
model categories {
  id                 BigInt               @id
  name               String
  slug               String               @unique
  description        String?
  parent_id          BigInt?
  image_url          String?
  product_count      Int                  @default(0)
  sort_order         Int                  @default(0)
  is_hidden          Boolean              @default(false)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  categories         categories?          @relation("categoriesTocategories", fields: [parent_id], references: [id], onUpdate: NoAction)
  other_categories   categories[]         @relation("categoriesTocategories")
  product_categories product_categories[]
  @@index([parent_id])
  @@index([slug])
  @@schema("public")
}

model leads {
  id         BigInt    @id @default(autoincrement())
  name       String
  phone      String
  email      String?
  message    String?
  product_id BigInt?
  source     String?
  status     String    @default("new")
  note       String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  products   products? @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  @@index([status, created_at(sort: Desc)])
  @@schema("public")
}

model pages {
  id               BigInt  @id
  title            String
  slug             String  @unique
  content          String?
  meta_title       String?
  meta_description String?
  is_published     Boolean @default(true)
  @@schema("public")
}

model post_term_links {
  post_id    BigInt
  term_id    BigInt
  posts      posts      @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  post_terms post_terms @relation(fields: [term_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@id([post_id, term_id])
  @@index([term_id])
  @@schema("public")
}

model post_terms {
  id              BigInt            @id
  name            String
  slug            String
  description     String?
  taxonomy        String
  post_count      Int               @default(0)
  post_term_links post_term_links[]
  @@unique([taxonomy, slug])
  @@index([taxonomy, post_count(sort: Desc)])
  @@index([taxonomy, slug])
  @@schema("public")
}

model posts {
  id               BigInt            @id
  title            String
  slug             String            @unique
  excerpt          String?
  content          String?
  cover_image      String?
  meta_title       String?
  meta_description String?
  is_published     Boolean           @default(true)
  published_at     DateTime?         @db.Timestamptz(6)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  post_term_links  post_term_links[]
  @@index([is_published, published_at(sort: Desc)])
  @@schema("public")
}

model product_categories {
  product_id  BigInt
  category_id BigInt
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products    products   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@id([product_id, category_id])
  @@index([category_id])
  @@schema("public")
}

model product_images {
  id           BigInt   @id @default(autoincrement())
  product_id   BigInt
  storage_path String
  alt          String?
  is_primary   Boolean  @default(false)
  sort_order   Int      @default(0)
  products     products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@index([product_id, sort_order])
  @@schema("public")
}

model product_tags {
  product_id BigInt
  tag_id     BigInt
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tags       tags     @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@id([product_id, tag_id])
  @@index([tag_id])
  @@schema("public")
}

model product_variants {
  id           BigInt   @id
  product_id   BigInt
  name         String?
  sku          String?
  price        BigInt?
  attributes   Json     @default("{}")
  image_url    String?
  is_available Boolean  @default(true)
  sort_order   Int      @default(0)
  products     products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@index([product_id])
  @@schema("public")
}

model products {
  id                 BigInt               @id
  name               String
  slug               String               @unique
  sku                String?
  short_description  String?
  description        String?
  price              BigInt?
  regular_price      BigInt?
  sale_price         BigInt?
  price_min          BigInt?
  price_max          BigInt?
  on_sale            Boolean              @default(false)
  has_variants       Boolean              @default(false)
  is_available       Boolean              @default(true)
  is_published       Boolean              @default(true)
  is_featured        Boolean              @default(false)
  meta_title         String?
  meta_description   String?
  search_text        String?
  sort_order         Int                  @default(0)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  leads              leads[]
  product_categories product_categories[]
  product_images     product_images[]
  product_tags       product_tags[]
  product_variants   product_variants[]
  @@index([is_published, sort_order])
  @@index([slug])
  @@schema("public")
}

model redirects {
  id          BigInt @id @default(autoincrement())
  from_path   String @unique
  to_path     String
  status_code Int    @default(301)
  @@schema("public")
}

model tags {
  id            BigInt         @id
  name          String
  slug          String         @unique
  description   String?
  product_count Int            @default(0)
  product_tags  product_tags[]
  @@index([product_count(sort: Desc)])
  @@index([slug])
  @@schema("public")
}

model Visit {
  id        Int      @id @default(autoincrement())
  count     BigInt   @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

// --- Koi Free Style Models (Koi Leather App) ---
model KoiCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  slug        String   @unique
  description String?
  specsSchema String   @default("{}")
  metaTitle       String?
  metaDescription String?
  displayOrder    Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products KoiProduct[]
  categoryLinks KoiProductCategory[]
  @@index([isActive])
  @@index([displayOrder])
  @@map("koi_categories")
  @@schema("koi_free_style")
}

// Bảng nối nhiều–nhiều: 1 sản phẩm thuộc nhiều danh mục và ngược lại.
// categoryId cũ trên KoiProduct vẫn giữ làm "danh mục chính" (tương thích ngược).
model KoiProductCategory {
  productId  String
  categoryId String
  product    KoiProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   KoiCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("koi_product_categories")
  @@schema("koi_free_style")
}

model KoiProduct {
  id           String @id @default(uuid())
  name         String
  slug         String @unique
  productType  String
  categoryId   String?
  description  String?
  basePrice    Float?
  priceMin     Float?
  priceMax     Float?
  hasVariants  Boolean @default(false)
  status       String @default("DRAFT")
  sku          String? @unique
  externalId   String?
  technicalSpecs String @default("{}")
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  category    KoiCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryLinks KoiProductCategory[]
  images      KoiProductImage[]
  variants    KoiProductVariant[]
  craftSpecs  KoiCraftingSpec[]
  seoRecords  KoiSEORecord[]
  @@index([productType])
  @@index([status])
  @@index([slug])
  @@index([categoryId])
  @@index([createdAt])
  @@index([categoryId, status])
  @@map("koi_products")
  @@schema("koi_free_style")
}

model KoiProductImage {
  id        String @id @default(uuid())
  productId String
  variantId String?
  url           String
  thumbnailUrl  String
  mediumUrl     String?
  altText       String?
  imageType     String  @default("STUDIO")
  isPrimary     Boolean @default(false)
  displayOrder  Int     @default(0)
  mimeType      String?
  fileSize      Int?
  width         Int?
  height        Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product KoiProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant KoiProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  @@index([productId])
  @@index([variantId])
  @@index([isPrimary])
  @@map("koi_product_images")
  @@schema("koi_free_style")
}

model KoiProductVariant {
  id        String @id @default(uuid())
  productId String
  sku         String @unique
  title       String?
  price       Float?
  hardwareOption String @default("none")
  stockStatus String @default("IN_STOCK")
  isDefault   Boolean @default(false)
  options String @default("{}")
  images  String?
  craftingSpecId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product      KoiProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
  craftingSpec KoiCraftingSpec?  @relation(fields: [craftingSpecId], references: [id], onDelete: SetNull)
  images_rel   KoiProductImage[]
  orders       KoiProductionOrder[]
  @@index([productId])
  @@index([sku])
  @@index([stockStatus])
  @@map("koi_product_variants")
  @@schema("koi_free_style")
}

model KoiCraftingSpec {
  id        String @id @default(uuid())
  productId String
  patternFiles    String @default("[]")
  outerLeather    String @default("{}")
  liningLeather   String @default("{}")
  interlining     String @default("{}")
  dimensions      String @default("{}")
  craftingDetails String @default("{}")
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product  KoiProduct          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants KoiProductVariant[]
  @@index([productId])
  @@map("koi_crafting_specs")
  @@schema("koi_free_style")
}

model KoiRawMaterial {
  id         String @id @default(uuid())
  name       String
  materialType String
  supplier   String?
  unit       String
  color      String?
  thicknessMm Float?
  totalQuantity     Float @default(0)
  reservedQuantity  Float @default(0)
  availableQuantity Float @default(0)
  unitCost    Float
  currency    String @default("VND")
  externalId    String?
  lastSyncedAt  DateTime?
  syncStatus    String? @default("SYNCED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  materialCategoryId String?
  materialCategory KoiMaterialCategory? @relation(fields: [materialCategoryId], references: [id], onDelete: SetNull)
  transactions KoiInventoryTransaction[]
  @@index([materialType])
  @@index([externalId])
  @@index([supplier])
  @@index([materialCategoryId])
  @@map("koi_raw_materials")
  @@schema("koi_free_style")
}

model KoiInventoryTransaction {
  id         String @id @default(uuid())
  materialId String
  orderId    String?
  transactionType String
  quantity        Float
  batchRef        String?
  costAtTransaction Float?
  notes String?
  createdAt DateTime @default(now())
  material KoiRawMaterial @relation(fields: [materialId], references: [id])
  @@index([materialId])
  @@index([orderId])
  @@index([transactionType])
  @@index([createdAt])
  @@map("koi_inventory_transactions")
  @@schema("koi_free_style")
}

model KoiProductionOrder {
  id        String @id @default(uuid())
  variantId String
  quantity  Int
  status    String @default("PENDING")
  craftsman String?
  dueDate   DateTime?
  materialsAllocated String @default("[]")
  totalCostSnapshot   Float?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  variant KoiProductVariant @relation(fields: [variantId], references: [id], onDelete: SetNull)
  @@index([variantId])
  @@index([status])
  @@index([createdAt])
  @@map("koi_production_orders")
  @@schema("koi_free_style")
}

model KoiSEORecord {
  id         String @id @default(uuid())
  entityType String
  entityId   String
  slug        String @unique
  slugHistory String @default("[]")
  jsonLd String @default("{}")
  ogTitle       String?
  ogDescription String?
  ogImage       String?
  metaTitle       String?
  metaDescription String?
  noIndex         Boolean @default(false)
  sitemapPriority  Float?
  sitemapChangeFreq String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product KoiProduct? @relation(fields: [entityId], references: [id], onDelete: Cascade)
  @@index([entityType, entityId])
  @@index([slug])
  @@map("koi_seo_records")
  @@schema("koi_free_style")
}

model KoiImageCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([code])
  @@map("koi_image_categories")
  @@schema("koi_free_style")
}

model KoiMaterialCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  materials   KoiRawMaterial[]
  @@index([code])
  @@map("koi_material_categories")
  @@schema("koi_free_style")
}

// --- Shopee Ads ---
// Số liệu quảng cáo Shopee được sync định kỳ vào đây rồi admin UI đọc từ DB.
// Không gọi Shopee API trực tiếp lúc mở tab vì Vercel giới hạn 30s/request.

// Một dòng = một campaign trong một ngày. Chỉ lưu số thô (chi phí, click,
// impression, GMV, đơn); mọi tỷ lệ (ROAS/CTR/CR) được tính lại lúc đọc để
// tránh sai số làm tròn của API.
model KoiShopeeAdsDaily {
  id         String   @id @default(uuid())
  shopId     BigInt
  date       DateTime @db.Date
  campaignId BigInt
  // Snapshot tên/loại/ngân sách tại thời điểm sync — campaign đổi tên sau này
  // thì báo cáo cũ vẫn đọc được đúng bối cảnh.
  name        String?
  adType      String?
  status      String?
  dailyBudget Float?

  expense     Float @default(0)
  impression  Int   @default(0)
  click       Int   @default(0)
  order       Int   @default(0)
  gmv         Float @default(0)
  directOrder Int   @default(0)
  directGmv   Float @default(0)

  syncedAt DateTime @default(now())

  // Sync lại cùng một ngày phải ghi đè, không tạo dòng trùng.
  @@unique([shopId, date, campaignId])
  @@index([shopId, date])
  @@map("koi_shopee_ads_daily")
  @@schema("koi_free_style")
}

// Tổng hợp toàn shop theo ngày. Tách riêng vì Shopee tính GMV toàn shop có
// quy kết khác tổng các campaign — cộng dồn bảng trên sẽ ra số lệch.
model KoiShopeeAdsShopDaily {
  id     String   @id @default(uuid())
  shopId BigInt
  date   DateTime @db.Date

  expense     Float @default(0)
  impression  Int   @default(0)
  click       Int   @default(0)
  order       Int   @default(0)
  gmv         Float @default(0)
  directOrder Int   @default(0)
  directGmv   Float @default(0)

  syncedAt DateTime @default(now())

  @@unique([shopId, date])
  @@index([shopId, date])
  @@map("koi_shopee_ads_shop_daily")
  @@schema("koi_free_style")
}

// Trạng thái lần sync gần nhất: để UI hiển thị "số liệu cập nhật lúc ..." và
// để biết sync có lỗi hay không mà không phải đọc log Vercel.
model KoiShopeeAdsSyncState {
  id     String @id @default(uuid())
  shopId BigInt @unique

  lastSyncAt      DateTime?
  lastSyncStatus  String?   // ok | partial | error
  lastSyncMessage String?
  lastDateSynced  DateTime? @db.Date
  rowsWritten     Int       @default(0)

  // Số dư ví ads, dùng để cảnh báo sắp hết tiền.
  balance    Float?
  autoTopUp  Boolean?

  updatedAt DateTime @updatedAt

  @@map("koi_shopee_ads_sync_state")
  @@schema("koi_free_style")
}

// Credential Shopee Open Platform. Lưu ở DB thay vì env vì access_token chỉ
// sống 4 tiếng và phải được làm mới liên tục — serverless không ghi lại được
// biến môi trường giữa các lần gọi, nên token mới sẽ mất sau mỗi request.
//
// partnerKey / accessToken / refreshToken được mã hoá AES-256-GCM trước khi
// ghi (xem shopee-ads.crypto.ts). Cột chỉ chứa ciphertext, không bao giờ chứa
// giá trị thật, để một lần lộ dump DB không đủ để gọi API thay shop.
model KoiShopeeCredential {
  id       String @id @default("default")
  partnerId BigInt
  shopId    BigInt

  partnerKeyEnc   String
  accessTokenEnc  String?
  refreshTokenEnc String?

  // live | sandbox
  env String @default("live")

  // Hết hạn access_token do Shopee trả về (expire_in giây kể từ lúc lấy).
  tokenExpiresAt DateTime?

  authorizedAt DateTime?
  updatedBy    String?
  updatedAt    DateTime @updatedAt

  @@map("koi_shopee_credential")
  @@schema("koi_free_style")
}
