generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// CATEGORY ENUM
// ============================================================

enum CategoryCode {
  WATCH_STRAP  @map("WATCH_STRAP")
  WALLET       @map("WALLET")
  BELT         @map("BELT")
  BAG          @map("BAG")
  ACCESSORY    @map("ACCESSORY")
}

// ============================================================
// ENUMS
// ============================================================

enum ProductType {
  WALLET        @map("Ví")
  BELT          @map("Thắt_lưng")
  WATCH_STRAP   @map("Watch_Strap")
  BAG           @map("Túi")
  ACCESSORY     @map("Phụ_kiện")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MaterialType {
  OUTER_LEATHER    @map("Da_ngoài")
  LINING_LEATHER   @map("Da_lót")
  INTERLINING      @map("Độn")
  THREAD           @map("Chỉ")
  BUCKLE           @map("Khóa")
  HARDWARE         @map("Phụ_kiện")
}

enum MaterialUnit {
  SQFT
  METER
  PIECE
  ROLL
}

enum TransactionType {
  RECEIPT
  CONSUMPTION
  RESERVATION
  RELEASE
  ADJUSTMENT
}

enum OrderStatus {
  PENDING
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum EntityType {
  PRODUCT
  COLLECTION
  ARTICLE
  PAGE
}

// ============================================================
// CATEGORY
// ============================================================

model Category {
  id        String        @id @default(uuid())
  code      CategoryCode  @unique
  name      String
  slug      String        @unique
  description String?
  specsSchema  Json        @default("{}") @map("specs_schema")
  // JSON Schema Draft-07 defining the technical specs structure for this category.
  // The Admin UI uses this to render dynamic input forms per product type.
  // Example (watch_strap):
  // {
  //   "$schema": "http://json-schema.org/draft-07/schema#",
  //   "type": "object",
  //   "properties": {
  //     "lug_width_mm": { "type": "integer", "minimum": 14, "maximum": 26, "title": "Lug Width (mm)", "koi:ui": { "component": "select", "options": [14,16,18,19,20,22,24,26] } },
  //     "buckle_width_mm": { "type": "integer", "minimum": 12, "maximum": 24, "title": "Buckle Width (mm)" },
  //     "short_strap_mm": { "type": "integer", "minimum": 60, "maximum": 130, "title": "Short Strap (mm)" },
  //     "long_strap_mm": { "type": "integer", "minimum": 60, "maximum": 140, "title": "Long Strap (mm)" },
  //     "taper_from_mm": { "type": "number", "minimum": 2.0, "maximum": 6.0, "title": "Taper From (mm)" },
  //     "taper_to_mm": { "type": "number", "minimum": 1.0, "maximum": 4.0, "title": "Taper To (mm)" },
  //     "padding": { "type": "string", "enum": ["flat", "padded"], "title": "Padding Type" }
  //   },
  //   "required": ["lug_width_mm", "buckle_width_mm", "short_strap_mm", "long_strap_mm", "taper_from_mm", "taper_to_mm"]
  // }

  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")

  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt

  products Product[]

  @@index([code])
  @@index([slug])
  @@map("categories")
}

// ============================================================
// PRODUCT
// ============================================================

model Product {
  id           String        @id @default(uuid())
  name         Json          // { "vi": "Ví đứng Epsom Navy", "en": "Epsom Navy Bifold Wallet" }
  slug         String        @unique
  productType  ProductType   @map("product_type")
  categoryId   String?       @map("category_id")
  description  Json?         // Rich text, multi-lang { "vi": "...", "en": "..." }
  basePrice    Decimal?      @map("base_price") @db.Decimal(12, 2)
  priceMin     Decimal?      @map("price_min") @db.Decimal(12, 2)
  priceMax     Decimal?      @map("price_max") @db.Decimal(12, 2)
  hasVariants  Boolean       @default(false) @map("has_variants")
  status       ProductStatus @default(DRAFT)
  sku          String?       @unique
  externalId   String?       @map("external_id") // kitleather.vn ID for sync

  // JSONB: flexible specs per product type
  // Validated against Category.specs_schema at create/update time
  technicalSpecs Json  @default("{}") @map("technical_specs")

  // SEO metadata
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  canonicalUrl    String?  @map("canonical_url")

  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt

  // Relations
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  variants    ProductVariant[]
  craftSpecs  CraftingSpec[]
  seoRecords  SEORecord[]

  @@index([productType])
  @@index([categoryId])
  @@index([status])
  @@index([slug])
  @@map("products")
}

// ============================================================
// PRODUCT IMAGE
// ============================================================

model ProductImage {
  id        String @id @default(uuid())
  productId String @map("product_id")
  variantId String? @map("variant_id")

  url           String  // Full HD / original
  thumbnailUrl  String  @map("thumbnail_url") // 150x150
  mediumUrl     String? @map("medium_url")    // 600x600
  altText       String? @map("alt_text")      // Auto-populated from Product Name + Leather Spec
  isPrimary     Boolean @default(false) @map("is_primary")
  displayOrder  Int     @default(0) @map("display_order")
  mimeType      String? @map("mime_type")
  fileSize      Int?    @map("file_size")     // bytes
  width         Int?
  height        Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@index([isPrimary])
  @@map("product_images")
}

// ============================================================
// PRODUCT VARIANT
// ============================================================

model ProductVariant {
  id        String @id @default(uuid())
  productId String @map("product_id")

  sku         String  @unique
  title       String? @map("title")
  price       Decimal? @db.Decimal(12, 2)
  hardwareOption String @default("none") @map("hardware_option")
  stockStatus String  @default("IN_STOCK") @map("stock_status") // IN_STOCK, MADE_TO_ORDER, OUT_OF_STOCK
  isDefault   Boolean @default(false) @map("is_default")

  // Options as JSONB — e.g. { "leather": "Epsom Navy", "lugWidth": "20-18", "length": "115/75", "threadColor": "Beige" }
  options     Json    @default("{}")
  images      Json?   // Array of variant-specific image URLs (override product images)

  craftingSpecId String? @map("crafting_spec_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  craftingSpec CraftingSpec?  @relation(fields: [craftingSpecId], references: [id], onDelete: SetNull)
  images_rel   ProductImage[]
  orders       ProductionOrder[]

  @@index([productId])
  @@index([sku])
  @@index([stockStatus])
  @@map("product_variants")
}

// ============================================================
// CRAFTING SPEC
// ============================================================

model CraftingSpec {
  id        String @id @default(uuid())
  productId String @map("product_id")

  // Pattern files: [{ "version": "v2.1", "url": "https://...", "pieceCount": 7, "format": "PDF" }]
  patternFiles Json @default("[]") @map("pattern_files")

  // Outer leather spec
  outerLeather    Json @default("{}") @map("outer_leather")
  // { "material_name": "Epsom Navy", "tannery": "Haas", "sqft": 0.8, "wastage_rate": 0.15, "color": "Navy", "thickness_mm": 1.2 }

  // Lining leather spec
  liningLeather   Json @default("{}") @map("lining_leather")
  // { "material_name": "Zermatt Beige", "tannery": "Haas", "sqft": 0.5, "wastage_rate": 0.1 }

  // Interlining / reinforcement spec
  interlining     Json @default("{}") @map("interlining")
  // { "material_name": "Salpa 1.0mm", "sqft": 0.4, "thickness_mm": 1.0 }

  // Dimensions spec — type-specific
  dimensions      Json @default("{}")
  // Watch Strap: { "lug_width_mm": 20, "buckle_width_mm": 18, "short_strap_mm": 115, "long_strap_mm": 75, "taper_from_mm": 4.0, "taper_to_mm": 2.0 }
  // Wallet: { "folded_width_cm": 11, "folded_height_cm": 9, "card_slots": 8, "cash_pockets": 2 }
  // Belt: { "strap_width_cm": 3.4, "buckle_type": "Pin buckle", "strap_length_cm": 110, "hole_count": 7, "hole_spacing_cm": 2.5 }

  // Crafting details
  craftingDetails Json @default("{}") @map("crafting_details")
  // { "thread": "Meisi 0.45mm", "pitch_mm": 3.38, "edge_finishing": "Fenice", "stitching_type": "Saddle Stitch" }

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@index([productId])
  @@map("crafting_specs")
}

// ============================================================
// RAW MATERIAL
// ============================================================

model RawMaterial {
  id         String       @id @default(uuid())
  name       String
  materialType MaterialType @map("material_type")
  supplier   String?
  unit       MaterialUnit
  color      String?
  thicknessMm Decimal?    @map("thickness_mm") @db.Decimal(5, 2)

  // Stock quantities
  totalQuantity     Decimal @default(0) @map("total_quantity") @db.Decimal(12, 3)
  reservedQuantity  Decimal @default(0) @map("reserved_quantity") @db.Decimal(12, 3)
  availableQuantity Decimal @default(0) @map("available_quantity") @db.Decimal(12, 3)

  unitCost    Decimal @map("unit_cost") @db.Decimal(12, 2)
  currency    String  @default("VND")

  // kitleather.vn sync
  externalId    String?   @map("external_id")
  lastSyncedAt  DateTime? @map("last_synced_at")
  syncStatus    String?   @default("SYNCED") @map("sync_status") // SYNCED, PENDING, FAILED

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions InventoryTransaction[]

  @@index([materialType])
  @@index([externalId])
  @@index([supplier])
  @@map("raw_materials")
}

// ============================================================
// INVENTORY TRANSACTION
// ============================================================

model InventoryTransaction {
  id         String          @id @default(uuid())
  materialId String          @map("material_id")
  orderId    String?         @map("order_id")

  transactionType TransactionType @map("transaction_type")
  quantity        Decimal         @db.Decimal(12, 3) // Signed: +receipt, -consumption
  batchRef        String?         @map("batch_ref")
  costAtTransaction Decimal?      @map("cost_at_transaction") @db.Decimal(12, 2) // Snapshot of unit cost

  notes String?

  createdAt DateTime @default(now()) @map("created_at")

  material RawMaterial @relation(fields: [materialId], references: [id])

  @@index([materialId])
  @@index([orderId])
  @@index([transactionType])
  @@index([createdAt])
  @@map("inventory_transactions")
}

// ============================================================
// PRODUCTION ORDER
// ============================================================

model ProductionOrder {
  id        String @id @default(uuid())
  variantId String @map("variant_id")

  quantity   Int
  status     OrderStatus @default(PENDING)
  craftsman  String?
  dueDate    DateTime?   @map("due_date")

  // JSONB snapshot of allocated materials at time of order creation
  // [{ "material_id": "...", "material_name": "Da Epsom Navy", "qty_consumed": 0.8, "unit": "sqft", "cost_at_snapshot": 450000 }]
  materialsAllocated Json   @default("[]") @map("materials_allocated")
  totalCostSnapshot   Decimal? @map("total_cost_snapshot") @db.Decimal(14, 2)

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId])
  @@index([status])
  @@index([createdAt])
  @@map("production_orders")
}

// ============================================================
// SEO RECORD (Polymorphic)
// ============================================================

model SEORecord {
  id         String     @id @default(uuid())
  entityType EntityType @map("entity_type")
  entityId   String     @map("entity_id")

  slug        String @unique
  slugHistory Json    @default("[]") @map("slug_history") // [{ "slug": "/old-path", "redirected_at": "..." }]

  // JSON-LD structured data
  jsonLd Json @default("{}") @map("json_ld")

  // OpenGraph / Social
  ogTitle       String? @map("og_title")
  ogDescription String? @map("og_description")
  ogImage       String? @map("og_image")

  // Meta
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")
  noIndex         Boolean @default(false) @map("no_index")

  // Sitemap
  sitemapPriority Decimal? @map("sitemap_priority") @db.Decimal(3, 2)
  sitemapChangeFreq String? @map("sitemap_change_freq") // always, hourly, daily, weekly, monthly, yearly, never

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([slug])
  @@map("seo_records")
}
