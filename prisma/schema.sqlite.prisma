generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./koi_leather.db"
}

model Category {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  slug        String    @unique
  description String?
  specsSchema Json      @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id           String  @id @default(uuid())
  name         Json
  slug         String  @unique
  productType  String  // WALLET, BELT, WATCH_STRAP, BAG, ACCESSORY
  categoryId   String?
  description  Json?
  basePrice    Float?
  status       String  @default("DRAFT")
  sku          String? @unique
  externalId   String?

  technicalSpecs Json @default("{}")

  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  variants    ProductVariant[]
  craftSpecs  CraftingSpec[]
  seoRecords  SEORecord[]

  @@index([productType])
  @@index([status])
  @@index([slug])
}

model ProductImage {
  id        String @id @default(uuid())
  productId String
  variantId String?

  url           String
  thumbnailUrl  String
  mediumUrl     String?
  altText       String?
  isPrimary     Boolean @default(false)
  displayOrder  Int     @default(0)
  mimeType      String?
  fileSize      Int?
  width         Int?
  height        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@index([isPrimary])
}

model ProductVariant {
  id        String @id @default(uuid())
  productId String

  sku         String @unique
  price       Float?
  stockStatus String @default("IN_STOCK")
  isDefault   Boolean @default(false)

  options Json @default("{}")
  images  Json?

  craftingSpecId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  craftingSpec CraftingSpec?  @relation(fields: [craftingSpecId], references: [id], onDelete: SetNull)
  images_rel   ProductImage[]
  orders       ProductionOrder[]

  @@index([productId])
  @@index([sku])
  @@index([stockStatus])
}

model CraftingSpec {
  id        String @id @default(uuid())
  productId String

  patternFiles   Json @default("[]")
  outerLeather   Json @default("{}")
  liningLeather  Json @default("{}")
  interlining    Json @default("{}")
  dimensions     Json @default("{}")
  craftingDetails Json @default("{}")

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@index([productId])
}

model RawMaterial {
  id         String @id @default(uuid())
  name       String
  materialType String // OUTER_LEATHER, LINING_LEATHER, INTERLINING, THREAD, BUCKLE, HARDWARE
  supplier   String?
  unit       String // SQFT, METER, PIECE, ROLL
  color      String?
  thicknessMm Float?

  totalQuantity     Float @default(0)
  reservedQuantity  Float @default(0)
  availableQuantity Float @default(0)

  unitCost    Float
  currency    String @default("VND")

  externalId    String?
  lastSyncedAt  DateTime?
  syncStatus    String? @default("SYNCED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions InventoryTransaction[]

  @@index([materialType])
  @@index([externalId])
  @@index([supplier])
}

model InventoryTransaction {
  id         String @id @default(uuid())
  materialId String
  orderId    String?

  transactionType String // RECEIPT, CONSUMPTION, RESERVATION, RELEASE, ADJUSTMENT
  quantity        Float
  batchRef        String?
  costAtTransaction Float?

  notes String?

  createdAt DateTime @default(now())

  material RawMaterial @relation(fields: [materialId], references: [id])

  @@index([materialId])
  @@index([orderId])
  @@index([transactionType])
  @@index([createdAt])
}

model ProductionOrder {
  id        String @id @default(uuid())
  variantId String

  quantity  Int
  status    String @default("PENDING")
  craftsman String?
  dueDate   DateTime?

  materialsAllocated Json @default("[]")
  totalCostSnapshot   Float?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId])
  @@index([status])
  @@index([createdAt])
}

model SEORecord {
  id         String @id @default(uuid())
  entityType String // PRODUCT, COLLECTION, ARTICLE, PAGE
  entityId   String

  slug        String @unique
  slugHistory Json @default("[]")

  jsonLd Json @default("{}")

  ogTitle       String?
  ogDescription String?
  ogImage       String?

  metaTitle       String?
  metaDescription String?
  noIndex         Boolean @default(false)

  sitemapPriority  Float?
  sitemapChangeFreq String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([slug])
}
