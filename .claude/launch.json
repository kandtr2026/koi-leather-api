{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin-static",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8791", "--directory", "public"],
      "port": 8791
    },
    {
      "name": "koi-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "koi-storefront",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../koi-storefront", "run", "dev", "--", "-p", "3100"],
      "port": 3100
    }
  ]
}
