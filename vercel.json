{
  "version": 2,
  "buildCommand": "npx prisma generate && npm run build && node scripts/write-build-meta.js",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "regions": ["bom1"],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 300,
      "includeFiles": "{dist/src/**,public/**,data/**}"
    }
  },
  "crons": [
    { "path": "/analytics/ads/cron/sweep", "schedule": "0 3 * * *" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
